# Template only. Never commit real credentials or production URLs with embedded passwords.
PORT=3000
NODE_ENV=production
NEXUS_API_BASE=https://nexus.amadeustech.dev
NEXUS_SHOP_ID=
NEXUS_SHOP_TOKEN=
NEXUS_PRICE_CURRENCY=USD
NEXUS_USD_RUB=85
SALE_MARKUP=0.20

# Required for persistent admin sessions. Use Render's private Internal Database URL.
DATABASE_URL=
# Keep false after applying migrations/when schema is provisioned manually.
# true is an explicit opt-in to additive CREATE TABLE / ADD COLUMN IF NOT EXISTS operations only.
DB_AUTO_INIT=false
PGSSL_CA=
# Render web services normally sit behind one trusted proxy; set to 1 only after confirming topology.
TRUST_PROXY_HOPS=1
ADMIN_PASSWORD=
SESSION_SECRET=

# Safety interlock: orders, payments, receipt uploads, and UC fulfillment remain disabled in code.
SBP_ENABLED=false
SBP_PAYEE_NAME=
SBP_BANK_NAME=
SBP_PHONE=
SBP_PAYMENT_INSTRUCTIONS=
